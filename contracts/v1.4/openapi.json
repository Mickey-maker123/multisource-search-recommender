    "/api/engine/v1/health": {
      "get": {
        "operationId": "Health",
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive; inspect ready and capabilities separately",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "const": "1.0"
                    },
                    "status": {
                      "const": "ok"
                    },
                    "stage": {
                      "const": "D5"
                    },
                    "ready": {
                      "const": false
                    },
                    "capabilities": {
                      "type": "object",
                      "properties": {
                        "health": {
                          "type": "boolean"
                        },
                        "ingestion": {
                          "const": true
                        },
                        "search": {
                          "type": "boolean"
                        },
                        "personalization": {
                          "type": "boolean"
                        },
                        "analysis": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "health",
                        "ingestion",
                        "search",
                        "personalization",
                        "analysis"
                      ],
                      "additionalProperties": false
                    },
                    "dependencies": {
                      "const": "embedded_store"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "status",
                    "stage",
                    "ready",
                    "capabilities",
                    "dependencies"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "description": "D5 exposes ingestion, search, personalization, controlled analysis and local demo. Full release readiness is checked in D6-D7."
      }
