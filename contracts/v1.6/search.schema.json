{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engine.local/contracts/v1.6/search.schema.json",
  "$ref": "#/$defs/Search",
  "$defs": {
    "Task": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "taskId",
        "text",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "Filters": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "post",
              "document",
              "record",
              "attachment",
              "chunk"
            ]
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "updatedFrom": {
          "type": "string",
          "format": "date-time"
        },
        "updatedTo": {
          "type": "string",
          "format": "date-time"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "typed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "type",
              "op",
              "value"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
              },
              "type": {
                "enum": [
                  "string",
                  "decimal",
                  "date",
                  "boolean"
                ]
              },
              "op": {
                "enum": [
                  "eq",
                  "gte",
                  "lte"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "boolean"
                ]
              }
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Search": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.1"
        },
        "query": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "mode": {
          "type": "string",
          "enum": [
            "keyword",
            "vector",
            "hybrid"
          ]
        },
        "filters": {
          "$ref": "#/$defs/Filters"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      },
      "required": [
        "schemaVersion",
        "query",
        "mode",
        "pageSize"
      ],
      "additionalProperties": false
    }
  }
}
