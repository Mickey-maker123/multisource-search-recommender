  "components": {
    "securitySchemes": {
      "engineBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "D1 admin bootstrap only; not an end-user identity token"
      },
      "queryBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Trusted local identity token; operator-maintained private SHA-256 mapping. Never accept user/group identity from the body."
      }
    }
  }
